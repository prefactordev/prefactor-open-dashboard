# Copy this file to .env if you'd rather configure by file than in the UI.
# Everything here is optional — the dashboard's Admin panel can set the token
# for you (it validates it first and writes it here).

# Prefactor admin/session API token: a long "eyJ..." JWT from
# Account -> API Tokens in the Prefactor app. NOT the "pf_..." SDK ingestion
# key your agents use to send data — that one cannot read data back.
# Stays on this machine; the browser never receives it.
PREFACTOR_API_TOKEN=

# --- optional -------------------------------------------------------------
# PREFACTOR_API_HOST=https://app.prefactorai.com
# PORT=8788

# Where the cache and the saved token live. Point this at a persistent volume
# when hosting, so redeploys don't re-download your history.
# DATA_DIR=./data

# Hosting for others? Binding beyond localhost REQUIRES a password — the
# server refuses to start otherwise, because it holds an API token and shows
# everything your agents did. Put HTTPS in front of it.
# BIND_HOST=0.0.0.0
# DASHBOARD_PASSWORD=

# Comma-separated hostnames to accept when hosted, e.g. dash.example.com
# (localhost is always allowed, so this can't lock you out locally).
# ALLOWED_HOSTS=

# Poll cadence in ms — the ceiling on how "live" the dashboard is.
# SYNC_INTERVAL_MS=15000

# How far back history is fetched on first run.
# BACKFILL_HORIZON_DAYS=90

# Stops backfill early on very large agents.
# MAX_CACHE_SPANS_PER_AGENT=60000
