{
  "name": "prefactor-open-dashboard",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source local dashboard for Prefactor agent telemetry: risk, quality, and cost, computed from your own account's raw spans.",
  "keywords": [
    "prefactor",
    "ai-agents",
    "observability",
    "dashboard",
    "llm",
    "telemetry",
    "agent-monitoring"
  ],
  "homepage": "https://github.com/prefactordev/prefactor-open-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/prefactordev/prefactor-open-dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/prefactordev/prefactor-open-dashboard/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server.mjs",
    "build": "tsc --noEmit && vite build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "shots": "node scripts/screenshots.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "demo": "node scripts/demo.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^5.0.3"
  }
}
